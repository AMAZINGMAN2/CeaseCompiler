int x = 10;
int* p = &x;
int** pp = &p;

*p = 25;
**pp = *p + 17; // 25 + 17 = 42

int y = 0;
{
    int* inner = &y;
    *inner = 5;
}

if (p == &x) {
    exit(**pp + y); // 42 + 5 = 47
}



